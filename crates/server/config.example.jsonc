{
  // Private startup configuration. Copy to .microcrab/config.jsonc.
  // Relative paths resolve from the server's startup working directory.
  "listen": "127.0.0.1:4096",
  "data_dir": ".microcrab",
  "storage": "sqlite",
  "frontend_dir": "public",
  "max_active_sessions": 64,
  "auto_rename": true,
  "auth": {
    // Requires the Server's non-default dev feature. Start only the Server;
    // its actual loopback listener supplies the same-port issuer and endpoints.
    // Bootstrap validates shared metadata directly without a self-HTTP request.
    // Set dev_oidc false and configure your provider to select external OIDC.
    "dev_oidc": true,
    "discovery": true,
    "issuer": "http://127.0.0.1:4096/api/dev/oidc",
    "post_logout_redirect_uri": "http://127.0.0.1:4096/login",
    "client_id": "microcrab-dev",
    "redirect_uri": "http://127.0.0.1:4096/api/auth/callback",
    "post_login_redirect": "/",
    "allowed_origins": ["http://127.0.0.1:4096"],
    // Replace placeholders privately; env:VARIABLE secret references also work.
    "jwt_secret": "REPLACE_WITH_A_RANDOM_PRIVATE_SIGNING_SECRET_AT_LEAST_32_BYTES",
    "cookie_secure": false,
    "session_ttl_seconds": 900,
    "allow_http_loopback": true,
  },
  "provider": {
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "model": "gpt-4.1-mini",
    "api_key": "YOUR_LITERAL_API_KEY",
    "timeout_ms": 30000,
    "max_response_bytes": 262144,
  },
  // Projects are created/managed through the authenticated project API and
  // persisted in the project registry. There is no startup projects field.
  "agent": {"path": ".microcrab/agents/coding.wasm", "name": "coding", "mode": "plan"},
}
