{
  // AuthPortal 1.0.2 relying-party settings. Endpoints come from
  // {issuer}/.well-known/openid-configuration; explicit values override them.
  "auth": {
    "discovery": true,
    // Must equal AuthPortal's backend origin (its `origin` setting) exactly.
    "issuer": "https://auth.example.com",
    // Application-scoped JWKS publishes only this application's signing cert.
    "jwks_uri": "https://auth.example.com/.well-known/microcrab/jwks",
    // Literal registered OIDC client identifier; env: expansion is NOT supported here.
    "client_id": "REPLACE_WITH_REGISTERED_OIDC_CLIENT_ID",
    "client_secret": "env:MICROCRAB_OIDC_CLIENT_SECRET",
    "token_endpoint_auth_method": "client_secret_post",
    "scopes": ["openid", "profile"],
    "redirect_uri": "https://crab.example.com/api/auth/callback",
    // Register both URLs in the AuthPortal application's Redirect URLs.
    "post_logout_redirect_uri": "https://crab.example.com/login",
    "rp_logout": true,
    "require_callback_iss": true,
    "clock_skew_seconds": 60,
    // AuthPortal defaults to 168h ID tokens.
    "max_id_token_lifetime_seconds": 604800,
    "post_login_redirect": "/",
    "allowed_origins": ["https://crab.example.com"],
    "jwt_secret": "env:MICROCRAB_SESSION_SECRET",
    "cookie_secure": true,
    "session_ttl_seconds": 900,
    "allow_http_loopback": false,
  },
}
